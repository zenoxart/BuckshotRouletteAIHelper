<Window x:Class="BuckshotRouletteHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:BuckshotRouletteHelper"
        mc:Ignorable="d"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Buckshot Roulette AI Helper"
        Height="520" Width="580">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Buckshot Roulette AI Helper"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,16"/>

        <!-- Chambers and Bullets Input Row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chambers -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Chambers" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4"/>
                <ui:NumberBox x:Name="ChambersTextBox"
                              SpinButtonPlacementMode="Compact"
                              Minimum="0"
                              Maximum="20"
                              SmallChange="1"
                              ValueChanged="ChambersTextBox_ValueChanged"/>
            </StackPanel>

            <!-- Loaded Hits -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Loaded Hits" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4"/>
                <ui:NumberBox x:Name="BulletsTextBox"
                              SpinButtonPlacementMode="Compact"
                              Minimum="0"
                              Maximum="20"
                              SmallChange="1"
                              ValueChanged="BulletsTextBox_ValueChanged"/>
            </StackPanel>
        </Grid>

        <!-- Control Buttons -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,12" HorizontalAlignment="Left">
            <Button Content="Subtract Bullet" Click="SubtractBulletButton_Click" Margin="0,0,8,8"/>
            <Button Content="Subtract Blank"  Click="SubtractBlankButton_Click"  Margin="0,0,8,8"/>
            <Button Content="Undo"            Click="UndoButton_Click"           Margin="0,0,8,8"/>
            <Button Content="Restart"         Click="RestartButton_Click"        Margin="0,0,0,8"
                    Style="{StaticResource AccentButtonStyle}"/>
        </WrapPanel>

        <!-- Won / Lost Buttons -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,12" HorizontalAlignment="Left">
            <Button Content="Won"  Click="LogWon_Click"  Margin="0,0,8,0"
                    Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="Lost" Click="LogLost_Click" Margin="0,0,0,0"/>
        </WrapPanel>

        <!-- Bet Suggestion -->
        <Border Grid.Row="4"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎯 " FontSize="16" VerticalAlignment="Center"/>
                <TextBlock x:Name="BetSuggestionTextBlock"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Text="Bet Suggestion: N/A"/>
            </StackPanel>
        </Border>

        <!-- Probability Info -->
        <Border Grid.Row="5"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,12"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock x:Name="ResultTextBlock"
                       FontSize="13"
                       LineHeight="22"/>
        </Border>

        <!-- Chamber Visualizer -->
        <Border Grid.Row="6"
                CornerRadius="8"
                Padding="8"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Canvas x:Name="ChambersCanvas" MinHeight="100"/>
        </Border>
    </Grid>
</Window>
